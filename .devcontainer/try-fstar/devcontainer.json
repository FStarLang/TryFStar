{
  "name": "Try F*: Pulse, PAL, and PAL-CSharp",
  "image": "ghcr.io/fstarlang/tryfstar@sha256:d01f1072e574f5d0a302f618f62b5bf7009bec8935201ffaaee49d184910df04",
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/website/playground",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "sh post-create.sh",
  "waitFor": "postCreateCommand",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "F* website and tutorial",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "FStarLang.fstar-vscode-assistant",
        "ms-vscode.cpptools",
        "ms-dotnettools.csharp",
        "Ionide.Ionide-fsharp"
      ],
      "settings": {
        "fstarVSCodeAssistant.verifyOnSave": true,
        "files.watcherExclude": {
          "**/_build/**": true
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
